# Copy this file to .env and fill in real values. Never commit .env.
# All variables are required unless marked optional.

# SMTP — used to send contact form and catalog download emails.
# For Gmail: enable 2FA, then generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# The email address that receives contact form submissions and
# catalog download notifications.
OWNER_EMAIL=you@example.com

# Required for secure, time-limited catalog download links (minimum 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CATALOG_DOWNLOAD_SECRET=replace-with-at-least-32-random-bytes
